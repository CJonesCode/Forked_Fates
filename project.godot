; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Forked Fates"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoloads/event_bus.gd"
GameManager="*res://autoloads/game_manager.gd"
SteamManager="*res://autoloads/steam_manager.gd"
UIManager="*res://scripts/ui/core/ui_manager.gd"
PoolManager="*res://scripts/core/pool_manager.gd"
DataManager="*res://scripts/core/data_manager.gd"
ConfigManager="*res://scripts/core/config_manager.gd"
PlayerManager="*res://scripts/core/player_manager.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/stretch/mode="viewport"

[input]

